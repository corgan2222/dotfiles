#!/bin/bash
# Modern replacements for classic commands: only in interactive shells and only when the tool is installed.
# .bashrc loads this file last, after all functions, so functions and scripts keep the classic commands (cat: the
# function below passes to the real cat whenever the output is no terminal).
# The classic command stays reachable as \ping, \df, \top or "command cat".
# Off: DOT_MODERN_ALIASES=0 (for example in ~/.extra).
[[ $- == *i* ]] || return 0
[ "${DOT_MODERN_ALIASES:-1}" = 0 ] && return 0

# true when the command exists, also in ~/.local/bin before that is in PATH
_dot_has() { command -v "$1" >/dev/null 2>&1 || [ -x "$HOME/.local/bin/$1" ]; }

# cat -> bat: syntax highlighting; -pp = plain and no pager. Debian and Ubuntu name the binary batcat: there "bat"
# works as well. Installed in a running shell, both apply after "reload".
# cat is a function, not an alias (28.10.26): bat fails on cat's options -s -E -v -T -A, so with an option, or with
# the output not on a terminal, the real cat runs. "sudo cat" sees no alias (alias sudo='sudo ') and runs the real
# cat; the alias before put bat there, which root's PATH may lack. \cat no longer skips it: "command cat" does.
if _dot_has bat || _dot_has batcat; then
  _dot_bat=$(type -P batcat || type -P bat || echo "$HOME/.local/bin/bat")
  _dot_has bat || alias bat="$(printf %q "$_dot_bat")"
  unalias cat 2>/dev/null
  function cat {
    local a
    [ -t 1 ] || { command cat "$@"; return; }
    for a; do case $a in -?*) command cat "$@"; return ;; esac; done
    "$_dot_bat" -pp "$@"
  }
fi

# ping -> gping: live latency graph, also several hosts at once; gping has no ping options, "ping -c 5 host" -> \ping
# gping runs the system ping underneath: without it (minimal images, containers) the alias would only fail
_dot_has gping && type -P ping >/dev/null && alias ping='gping'

# df -> duf: mounts as a readable table (duf replaces df; for du see ncdu)
_dot_has duf && alias df='duf'

# top -> btop, else htop
if _dot_has btop; then alias top='btop'; elif _dot_has htop; then alias top='htop'; fi

# du -> ncdu for an interactive overview of the current directory, classic du stays
_dot_has ncdu && alias dux='ncdu --color dark'

# short names for the docker and network TUIs
_dot_has lazydocker && alias lzd='lazydocker'
_dot_has rustnet && alias netmon='rustnet'

# xq: XML -> JSON with jq syntax, the same name everywhere (basics.sh installs yq). Debian names the one of python-yq
# xq-python; Fedora and openSUSE package only the Go yq of mikefarah, which converts with -p xml -o json
if ! _dot_has xq; then
  if _dot_has xq-python; then alias xq='xq-python'
  elif _dot_has yq; then xq() { yq -p xml -o json "$@"; }; fi
fi

unset -f _dot_has
