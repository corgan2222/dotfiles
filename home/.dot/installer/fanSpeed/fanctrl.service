[Unit]
Description=PWM fan control by CPU temperature
After=local-fs.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/fanctrl
# lgpio writes notification files into its working directory
RuntimeDirectory=fanctrl
WorkingDirectory=/run/fanctrl
ExecStart=/usr/local/bin/fan_ctrl.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
